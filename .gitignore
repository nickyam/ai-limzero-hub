# 构建产物
/public/

# 由 scripts/gen_resources.py 生成，非手工编辑（单一来源是 data/resources.yaml）
# 例外：两个 _index.md 是手写的 section 首页（/resources/ 与 /categories/ 的标题与正文），
# 必须入库 —— 否则 CI 侧构建出来的这两个页面标题会退化成英文目录名。
/content/resources/*
!/content/resources/_index.md
/content/categories/*
!/content/categories/_index.md

# Hugo 构建锁
.hugo_build.lock

# Python 缓存
__pycache__/
*.pyc

# 本地 Pagefind 二进制（scripts/dev.py 自动安装）
node_modules/
package-lock.json

# 候选发现产物（discover.py 生成，每次扫描都全量覆盖，不入库）
/inbox/candidates.json

# WorkBuddy 本地工作记忆与自动化运行日志（工具私有数据，与站点无关）
/.workbuddy/
